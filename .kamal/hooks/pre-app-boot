#!/usr/bin/env bash
# Stop-old-first fence (cube-worlds pattern): Kamal's default rolling deploy
# boots the new container before stopping the old one, so for a few seconds
# TWO pollers would watch the same token and post duplicate notifications to
# the channel — and race on the shared /data/tx.json cursor. So: stop every
# running container of this service BEFORE Kamal boots the new one. Downtime
# ~10s; the poller catches up from the persisted lastTxLt — overlap is the
# only hazard.
# Kamal runs hooks LOCALLY; fires on deploy, rollback, and app boot.
# Fail-closed: any error aborts the deploy with the old container still up.
set -euo pipefail
IFS=',' read -ra hosts <<< "${KAMAL_HOSTS:?}"
for host in "${hosts[@]}"; do
    # deploy is in the docker group; ssh port 666 per inventory.yml.
    # At pre-app-boot time the only running containers with this service
    # label are OLD ones (the new one hasn't booted) — stop them all.
    ssh -p 666 "deploy@${host}" \
        "docker ps -q --filter 'label=service=${KAMAL_SERVICE:?}' | xargs -r docker stop"
done
